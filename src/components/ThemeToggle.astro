---
import Icon from "./Icon.astro";

interface Props {
  class: string;
}
const { class: cls } = Astro.props;
---
<button type="button" class={cls} data-theme-toggle aria-label="Changer de thème">
  <span class="i-sun"><Icon name="sun" /></span><span class="i-moon"><Icon name="moon" /></span>
</button>

<script>
  // Theme toggle: remembers the choice, follows the system until one is made.
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function apply(theme: "light" | "dark") {
    root.setAttribute("data-theme", theme);
    const label = theme === "dark" ? "Passer au thème clair" : "Passer au thème sombre";
    toggles.forEach((t) => {
      t.setAttribute("aria-label", label);
      t.title = label;
    });
  }

  function stored(): string | null {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  }

  apply(root.getAttribute("data-theme") === "dark" ? "dark" : "light");
  toggles.forEach((t) =>
    t.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      apply(next);
      try {
        localStorage.setItem("theme", next);
      } catch {}
    }),
  );
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    const s = stored();
    if (s !== "light" && s !== "dark") apply(e.matches ? "dark" : "light");
  });
</script>
